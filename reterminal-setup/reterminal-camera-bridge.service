[Unit]
Description=reTerminal DM Native MJPEG Camera Streamer Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/nitek-checkin-kiosk/reterminal-setup
ExecStart=/usr/bin/python3 /home/pi/nitek-checkin-kiosk/reterminal-setup/mjpeg_server.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
