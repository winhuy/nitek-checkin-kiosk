[Unit]
Description=NITEK Check-in Kiosk Web Server
After=network.target reterminal-camera-bridge.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/nitek-checkin-kiosk
ExecStart=/usr/bin/npm exec vite preview --host 0.0.0.0 --port 4173
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
