{
  "name": "qr-checkin-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --windowed\"",
    "electron:start": "cross-env DISPLAY=:0 electron .",
    "electron:build:linux-arm64": "vite build && electron-builder --linux --arm64",
    "electron:build:linux-x64": "vite build && electron-builder --linux --x64",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.nitek.checkin.kiosk",
    "productName": "NITEK Checkin Kiosk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.112.2",
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "motion": "^13.1.0",
    "pullcord": "^0.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
